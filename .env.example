KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8501
VRIKSHA_BASE_URL=https://www.vriksha-capital.com

# Optional override. By default the app uses the first account with
# "has_paid_api": true in data/accounts.json for LTP.
KITE_MARKET_DATA_ACCOUNT_LABEL=

# Optional Selenium + TOTP auto-login.
# Use these fallback names for one Kite account:
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
KITE_AUTO_LOGIN_HEADLESS=1

# For multiple accounts, suffix variables with the account label uppercased and
# non-alphanumeric characters replaced by underscores. Example label "main":
# KITE_USER_ID_MAIN=
# KITE_PASSWORD_MAIN=
# KITE_TOTP_SECRET_MAIN=
